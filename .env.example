# AG Outbound Booking — environment
#
# Copy to .env.local and fill in. .env.local is gitignored (.gitignore line 34, ".env*").
#
# NONE of these may be prefixed with NEXT_PUBLIC_. That prefix inlines a value into the
# browser bundle, which for any key below means publishing it.
#
# See SETUP.md for where each value comes from.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API. The service role key BYPASSES row-level security, and every
# table in this app has RLS on with no policies, so this key is the only way in — and
# anyone holding it has full read/write on every client's contact data.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Google ──────────────────────────────────────────────────────────────────
# Google Auth Platform → Clients → Create client → Web application.
# The redirect URI must match EXACTLY, character for character, including the scheme
# and any trailing path. Google rejects a mismatch with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# ── Secrets you generate ────────────────────────────────────────────────────
# 32 bytes, base64. Encrypts stored refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOSING THIS MEANS EVERY CONNECTED CALENDAR MUST RECONNECT — the stored tokens become
# undecryptable. Keep a copy somewhere you trust before going live.
TOKEN_ENCRYPTION_KEY=

# Signs connect invites, OAuth state, manage tokens and operator sessions, AND is the
# bearer token for POST /api/links. See the warning in SETUP.md: it currently does two
# jobs, so anyone given it for minting can also forge manage tokens and ops sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LINKS_API_KEY=

# Bearer token for POST /api/cron/reminders. Unset means the cron refuses every request.
CRON_SECRET=

# Operator password for /ops. Minimum 12 characters; shorter or unset FAILS CLOSED and
# nobody can sign in. Use a password manager, not a memorable phrase.
OPS_PASSWORD=

# ── URLs ────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used to build booking links (/b/<token>) and the
# manage links embedded in calendar invitations. Getting this wrong ships dead links to
# real prospects, so change it when you deploy.
APP_BASE_URL=http://localhost:3000

# ── Reminders (optional) ────────────────────────────────────────────────────
# Without RESEND_API_KEY and REMINDER_FROM, reminders are recorded as 'skipped' with a
# reason. They are never silently dropped and never counted as sent.
RESEND_API_KEY=
# MUST NOT be a cold-outreach domain. Booking mail and campaign mail must not share a
# sending reputation; the app refuses to send if this matches COLD_EMAIL_DOMAINS.
REMINDER_FROM=bookings@book.agoutbound.co.uk
# Comma separated. The domains you send cold outreach from — this is the guard list.
COLD_EMAIL_DOMAINS=

# ── scripts/reconcile.py only ───────────────────────────────────────────────
# A short-lived Google access token for the live calendar check. Without it reconcile
# reports check 3 as SKIPPED, not passed.
GOOGLE_ACCESS_TOKEN=
